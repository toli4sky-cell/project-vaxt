# Copy to project root as .env for docker-compose overrides

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shift_timesheet
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/shift_timesheet

JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://localhost,http://localhost:80

BACKEND_PORT=8000
FRONTEND_PORT=80

# Локальная разработка (vite proxy): можно оставить пустым или указать бэкенд.
# Docker-образ фронта: обычно пусто — запросы идут на тот же хост, nginx проксирует /api.
VITE_API_URL=

# Сиды первого входа (backend)
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=ChangeMe123!
